# .env.example
# ---------------------------------------------------------------------------
# READ THIS FIRST
#
# This project is a STATIC site. There is no Vite, no webpack, no build step.
# Nothing reads a `.env` file at runtime in the browser, so these variables
# would silently do nothing if you relied on them.
#
# They are kept here only as a template / reference for tooling and humans.
#
# The real values live in `js/config.js`, which the browser loads directly.
# ---------------------------------------------------------------------------
#
# Safe to expose in frontend code (they are protected by RLS, not by secrecy):
SUPABASE_URL=https://fbqdpoqkbzbzvbrywaek.supabase.co
SUPABASE_ANON_KEY=sb_publishable_n-I8VgfUDnH3J35KZrLYsw_j1XTn0E5
#
# NEVER put these in the repository or in js/config.js:
# SUPABASE_SERVICE_ROLE_KEY=...      <- full database access, server-only
# SUPABASE_DB_PASSWORD=...           <- server-only
# ---------------------------------------------------------------------------